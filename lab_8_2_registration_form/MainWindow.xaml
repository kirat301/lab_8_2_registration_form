<Window x:Class="lab_8_2_registration_form.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_8_2_registration_form"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="553" 
        Width="780"
        MinHeight="250"
        MinWidth="300"
        MaxHeight="800"
        MaxWidth="1000">
    <Grid>
        <TextBlock x:Name="Name"
                   Text="Имя"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="Darkred"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="-2,39,409,0"/>
        <TextBox x:Name="txtName"
                 Height="23"
                 FontSize="15" 
                 Margin="216,38,437,453" 
                 TextChanged="txtName_TextChanged" 
                 RenderTransformOrigin="0.5,0.5"/>
        <TextBlock x:Name="SecondName"
                   Text="Фамилия"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="Darkred"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,67,402,0"/>
        <TextBox x:Name="txtSecondName"
                 Height="23"
                 FontSize="15" 
                 Margin="216,67,437,424" 
                 TextChanged="txtSecondName_TextChanged" 
                 RenderTransformOrigin="0.49,0.493"/>
        <TextBlock x:Name="Age"
                   Text="Возраст"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="Darkred"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,97,420,0"/>
        <TextBox x:Name="txtAge"
                 Height="23"
                 FontSize="15" 
                 Margin="216,97,437,394" 
                 TextChanged="txtAge_TextChanged" 
                 RenderTransformOrigin="0.49,0.493"/>
        <TextBlock x:Name="Email"
                   Text="Email"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="Darkred"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,127,420,10"/>
        <TextBox x:Name="txtEmail"
                 Height="23"
                 FontSize="15" 
                 Margin="216,127,437,364" 
                 TextChanged="txtName_TextChanged" 
                 RenderTransformOrigin="0.49,0.493"/>
        <TextBlock x:Name="Password"
                   Text="Пароль"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="Darkred"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,155,411,0"/>
        <TextBox x:Name="txtPassword"
                 Height="23"
                 FontSize="15"
                 Margin="216,155,437,336" 
                 TextChanged="txtPasswd_TextChanged" 
                 RenderTransformOrigin="0.49,0.493"/>
        <TextBlock x:Name="PasswordChek"
                   Text="Повтор пароля"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="Darkred"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,183,459,0"/>
        <TextBox x:Name="txtPasswordChek"
                 Height="23"
                 FontSize="15" Margin="216,183,437,308" 
                 TextChanged="txtPasswdChek_TextChanged" 
                 RenderTransformOrigin="0.49,0.493"/>
        <TextBlock x:Name="Role"
           Text="Роль"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="Darkred"
           TextWrapping="Wrap"
           TextAlignment="Center"
           Margin="0,213,407,0"/>
        <ComboBox x:Name="cmbRole"
                  Height="28"
                  SelectedIndex="0"
                  IsEditable="False"
                  SelectionChanged="cmbRole_SelectionChanged"
                  Margin="216,213,420,273">
            <ComboBoxItem Content="Администратор"/>
            <ComboBoxItem Content="Менеджер"/>
            <ComboBoxItem Content="Оператор"/>
        </ComboBox>
        <Button x:Name="btnClear"
                Content="Очистить"
                Width="80"
                Height="32"
                Margin="311,285,359,197"
                IsDefault="False"
                IsEnabled="True"
                ToolTip=""
                Click="btnClear_Click"/>
        <Button x:Name="btnRegistration"
                Content="Зарегистрировать"
                Height="32"
                Margin="83,285,503,197"
                IsDefault="False"
                IsEnabled="True"
                ToolTip=""
                Click="btnReg_Click"/>

    </Grid>
</Window>
